{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Docs app for ember-power-calendar addon",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "vite build --mode development && ember test --path dist",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/runtime": "^7.29.2",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/compat": "^4.1.21",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.2",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.5",
    "@embroider/vite": "^1.7.8",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.8.12",
    "@glint/template": "^1.7.8",
    "@glint/tsserver-plugin": "^2.5.18",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^10.0.3",
    "decorator-transforms": "^2.4.0",
    "ember-basic-dropdown": "^9.0.0",
    "ember-cli": "~6.12.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-concurrency": "^5.2.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-power-calendar": "workspace:*",
    "ember-power-calendar-moment": "^1.0.4",
    "ember-power-select": "^9.0.1",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.9.3",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.2.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.7.0",
    "moment": "^2.30.1",
    "prettier": "^3.9.5",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "rsvp": "^4.8.5",
    "sass-embedded": "^1.100.0",
    "shiki": "^4.3.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "testem": "^3.20.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  }
}
