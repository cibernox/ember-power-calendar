{
  "name": "ember-power-calendar",
  "version": "1.8.0",
  "description": "Powerful and customizable calendar component for Ember",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ember-power-addons/ember-power-calendar.git"
  },
  "license": "MIT",
  "author": "Miguel Camba",
  "imports": {
    "#src/*": "./src/*"
  },
  "sass": "./ember-power-calendar.scss",
  "style": "./dist/vendor/ember-power-calendar.css",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "sass": "./ember-power-calendar.scss",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./ember-power-calendar.less": "./ember-power-calendar.less",
    "./ember-power-calendar.scss": "./ember-power-calendar.scss",
    "./_index.scss": "./_index.scss",
    "./less/base.less": "./less/base.less",
    "./scss/base.scss": "./scss/base.scss",
    "./scss/mixins.scss": "./scss/mixins.scss",
    "./vendor/*": "./dist/vendor/*"
  },
  "files": [
    "_index.scss",
    "addon-main.cjs",
    "declarations",
    "dist",
    "ember-power-calendar.less",
    "ember-power-calendar.scss",
    "less",
    "scss"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "@embroider/macros": "^1.20.5",
    "decorator-transforms": "^2.4.0",
    "ember-element-helper": "^0.8.8",
    "ember-modifier": "^4.3.0",
    "ember-truth-helpers": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/runtime": "^7.29.2",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/library-tsconfig": "^2.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/addon-dev": "^8.3.1",
    "@embroider/compat": "^4.1.21",
    "@embroider/core": "^4.6.2",
    "@embroider/macros": "^1.20.5",
    "@embroider/vite": "^1.7.8",
    "@eslint/js": "^9.17.0",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.8.12",
    "@glint/template": "^1.7.8",
    "@glint/tsserver-plugin": "^2.5.18",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^10.0.3",
    "ember-basic-dropdown": "^9.0.0",
    "ember-concurrency": "^5.2.0",
    "ember-page-title": "^9.0.3",
    "ember-power-calendar-moment": "^1.0.4",
    "ember-qunit": "^9.1.0",
    "ember-route-template": "^1.0.3",
    "ember-source": "^7.1.0",
    "ember-strict-application-resolver": "^0.1.1",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.7.0",
    "moment": "^2.30.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "publint": "^0.3.21",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "release-plan": "^0.18.0",
    "rollup": "^4.62.2",
    "rollup-plugin-sass": "^1.15.3",
    "rsvp": "^4.8.5",
    "sass": "^1.101.0",
    "sass-embedded": "^1.100.0",
    "testem": "^3.20.1",
    "tracked-built-ins": "^4.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "@ember/test-helpers": "^5.0.0",
    "@glimmer/component": "^2.0.0",
    "ember-concurrency": "^5.1.0"
  },
  "packageManager": "pnpm@11.9.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/power-calendar-multiple.js": "./dist/_app_/components/power-calendar-multiple.js",
      "./components/power-calendar-multiple/days.js": "./dist/_app_/components/power-calendar-multiple/days.js",
      "./components/power-calendar-multiple/nav.js": "./dist/_app_/components/power-calendar-multiple/nav.js",
      "./components/power-calendar-range.js": "./dist/_app_/components/power-calendar-range.js",
      "./components/power-calendar-range/days.js": "./dist/_app_/components/power-calendar-range/days.js",
      "./components/power-calendar-range/nav.js": "./dist/_app_/components/power-calendar-range/nav.js",
      "./components/power-calendar.js": "./dist/_app_/components/power-calendar.js",
      "./components/power-calendar/days.js": "./dist/_app_/components/power-calendar/days.js",
      "./components/power-calendar/nav.js": "./dist/_app_/components/power-calendar/nav.js",
      "./helpers/ember-power-calendar-day-classes.js": "./dist/_app_/helpers/ember-power-calendar-day-classes.js",
      "./helpers/power-calendar-format-date.js": "./dist/_app_/helpers/power-calendar-format-date.js",
      "./services/power-calendar.js": "./dist/_app_/services/power-calendar.js",
      "./test-support/helpers.js": "./dist/_app_/test-support/helpers.js"
    }
  }
}
